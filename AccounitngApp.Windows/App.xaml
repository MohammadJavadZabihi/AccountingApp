<Application x:Class="AccounitngApp.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccounitngApp.Windows"
             StartupUri="/Views/Login.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resourcees/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="btnExite" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontFamily" Value="Vazir"/>
                <Setter Property="FontWeight" Value="Light"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="Foreground" Value="#111111"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#df3e3e"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="headerButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontFamily" Value="Vazir"/>
                <Setter Property="FontWeight" Value="Light"/>
                <Setter Property="FontSize" Value="25"/>
                <Setter Property="Foreground" Value="#111111"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#cfcfcf"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="textStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Vazir"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
            </Style>
            
            
        </ResourceDictionary>
    </Application.Resources>
</Application>

    